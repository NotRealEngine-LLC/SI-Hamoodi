# HAMOODI SyntheTech Intelligence — Environment Configuration Template
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git

# ===========================================
# REQUIRED: Supabase Configuration
# ===========================================
# Get these from your Supabase project dashboard
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key

# Application URL (used for auth callbacks and redirects)
VITE_APP_URL=http://localhost:3000

# ===========================================
# OPTIONAL: PostHog Analytics
# ===========================================
# Create a PostHog project at https://app.posthog.com
# VITE_POSTHOG_API_KEY=phc_your_posthog_api_key
# VITE_POSTHOG_HOST=https://app.posthog.com

# ===========================================
# OPTIONAL: Stripe Billing (Server-side only)
# ===========================================
# Create a Stripe account at https://stripe.com
# IMPORTANT: These keys should NEVER be exposed to the client
# STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Create products and prices in Stripe Dashboard
# STRIPE_PRICE_PLUS=price_your_plus_plan_price_id
# STRIPE_PRICE_PRO=price_your_pro_plan_price_id
# STRIPE_PRICE_TEAM=price_your_team_plan_price_id

# ===========================================
# OPTIONAL: Feature Flags
# ===========================================
# VITE_ENABLE_MARKETPLACE=false
# VITE_ENABLE_ADVANCED_AUTOMATION=false
# VITE_ENABLE_BILLING=false

# ===========================================
# OPTIONAL: External AI Providers
# ===========================================
# If using providers other than Puter.js
# OPENAI_API_KEY=sk-your-openai-key
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# ===========================================
# OPTIONAL: MCP Server Configuration
# ===========================================
# Register MCP servers in the Integrations Hub UI
# No environment variables needed for MCP

# ===========================================
# DEVELOPMENT ONLY
# ===========================================
# NODE_ENV=development
# DEBUG=false

# ===========================================
# SECURITY NOTES
# ===========================================
# 1. Never commit .env.local to git
# 2. Use different Supabase projects for dev/staging/prod
# 3. Rotate secrets regularly
# 4. Use Stripe test mode for development
# 5. Never share production credentials
# 6. Use environment-specific configuration
# 7. Enable RLS on all Supabase tables
# 8. Review security audit before launch

# ===========================================
# DEPLOYMENT NOTES
# ===========================================
# For Vercel/Netlify:
# - Add all variables in dashboard
# - Mark sensitive variables as encrypted
# - Use different projects for different environments
#
# For Docker:
# - Use docker secrets or environment files
# - Never bake secrets into images
# - Use volume mounts for sensitive config
#
# For self-hosted:
# - Use a secrets manager (Vault, AWS Secrets Manager)
# - Rotate credentials regularly
# - Monitor for unauthorized access
